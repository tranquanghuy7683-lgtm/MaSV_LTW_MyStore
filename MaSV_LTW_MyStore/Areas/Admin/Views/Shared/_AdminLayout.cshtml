<!DOCTYPE html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Quản trị MyStore</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/></head><body><nav class="navbar navbar-dark bg-dark"><div class="container"><a class="navbar-brand" href="@Url.Action("Index","Dashboard",new{area="Admin"})">MyStore | Quản trị</a><a class="nav-link text-white" href="@Url.Action("Index","Home",new{area=""})">Về trang bán hàng</a></div></nav><div class="container py-4"><div class="mb-3 d-flex gap-2 flex-wrap"><a class="btn btn-outline-primary" href="@Url.Action("Index","Categories")">Danh mục</a><a class="btn btn-outline-primary" href="@Url.Action("Index","Products")">Sản phẩm</a><a class="btn btn-outline-primary" href="@Url.Action("Index","Orders")">Đơn hàng</a></div>@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}@RenderBody()</div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>

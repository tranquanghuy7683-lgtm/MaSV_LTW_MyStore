@model IEnumerable<MaSV_LTW_MyStore.Models.Category>
<h2>Quản lý danh mục</h2><p><a class="btn btn-success" href="@Url.Action("Create")">Thêm danh mục</a></p><table class="table table-bordered bg-white"><thead><tr><th>Mã</th><th>Tên danh mục</th><th>Thao tác</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.CategoryID</td><td>@c.CategoryName</td><td><a class="btn btn-sm btn-warning" href="@Url.Action("Edit",new{id=c.CategoryID})">Sửa</a> <a class="btn btn-sm btn-danger" onclick="return confirm('Xóa danh mục này?')" href="@Url.Action("Delete",new{id=c.CategoryID})">Xóa</a></td></tr>}</tbody></table>

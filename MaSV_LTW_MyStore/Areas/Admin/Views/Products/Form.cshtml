@model MaSV_LTW_MyStore.Models.Product
@{var edit=Model.ProductID>0;ViewBag.Title=edit?"Sửa sản phẩm":"Thêm sản phẩm";}<h2>@ViewBag.Title</h2>@using(Html.BeginForm(edit?"Edit":"Create")){@Html.AntiForgeryToken()@Html.HiddenFor(m=>m.ProductID)<div class="mb-3"><label class="form-label">Danh mục</label>@Html.DropDownList("CategoryID",(SelectList)ViewBag.CategoryID,"-- Chọn danh mục --",new{@class="form-select"})</div><div class="mb-3"><label class="form-label">Tên sản phẩm</label>@Html.TextBoxFor(m=>m.ProductName,new{@class="form-control",required="required"})</div><div class="mb-3"><label class="form-label">Mô tả</label>@Html.TextAreaFor(m=>m.ProductDecription,new{@class="form-control",rows=4,required="required"})</div><div class="mb-3"><label class="form-label">Giá</label>@Html.TextBoxFor(m=>m.ProductPrice,new{@class="form-control",type="number",min="0",step="0.01",required="required"})</div><div class="mb-3"><label class="form-label">Đường dẫn ảnh (ví dụ ~/Content/images/phone.jpg)</label>@Html.TextBoxFor(m=>m.ProductImage,new{@class="form-control"})</div><button class="btn btn-primary">Lưu</button> <a class="btn btn-secondary" href="@Url.Action("Index")">Quay lại</a>}

@model IEnumerable<MaSV_LTW_MyStore.Models.Product>
<h2>Quản lý sản phẩm</h2><p><a class="btn btn-success" href="@Url.Action("Create")">Thêm sản phẩm</a></p><form class="d-flex mb-3" method="get"><input class="form-control me-2" name="q" value="@ViewBag.Query" placeholder="Tìm tên sản phẩm"/><button class="btn btn-outline-primary">Tìm</button></form><table class="table table-bordered bg-white"><thead><tr><th>Mã</th><th>Tên</th><th>Danh mục</th><th>Giá</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.ProductID</td><td>@p.ProductName</td><td>@p.Category.CategoryName</td><td>@p.ProductPrice.ToString("N0") đ</td><td><a class="btn btn-sm btn-warning" href="@Url.Action("Edit",new{id=p.ProductID})">Sửa</a> <a class="btn btn-sm btn-danger" onclick="return confirm('Xóa sản phẩm này?')" href="@Url.Action("Delete",new{id=p.ProductID})">Xóa</a></td></tr>}</tbody></table>

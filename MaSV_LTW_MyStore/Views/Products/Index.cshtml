@model IEnumerable<MaSV_LTW_MyStore.Models.Product>
<h2 class="mb-3">Danh sách sản phẩm</h2><form class="row g-2 mb-4" method="get"><div class="col-md-5"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Tìm tên, mô tả, danh mục..."/></div><div class="col-md-3"><select class="form-select" name="categoryId"><option value="">Tất cả danh mục</option>@foreach(var c in (IEnumerable<MaSV_LTW_MyStore.Models.Category>)ViewBag.Categories){<option value="@c.CategoryID" @(ViewBag.CategoryId==c.CategoryID?"selected":"")>@c.CategoryName</option>}</select></div><div class="col-md-2"><select class="form-select" name="sort"><option value="name">Tên A-Z</option><option value="priceup" @(ViewBag.Sort=="priceup"?"selected":"")>Giá tăng</option><option value="pricedown" @(ViewBag.Sort=="pricedown"?"selected":"")>Giá giảm</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100">Tìm kiếm</button></div></form><div class="row g-3">@foreach(var p in Model){<div class="col-6 col-md-3"><div class="card product"><img class="card-img-top" style="height:160px;object-fit:contain" src="@(string.IsNullOrEmpty(p.ProductImage)?"https://placehold.co/300x200?text=Product":Url.Content(p.ProductImage))"/><div class="card-body"><small class="text-muted">@p.Category.CategoryName</small><h6>@p.ProductName</h6><div class="price">@p.ProductPrice.ToString("N0") đ</div><a class="btn btn-sm btn-primary mt-2" href="@Url.Action("Details",new{id=p.ProductID})">Chi tiết</a></div></div></div>}</div><nav class="mt-4"><ul class="pagination">@for(int i=1;i<=(int)ViewBag.TotalPages;i++){<li class="page-item @((int)ViewBag.Page==i?"active":"")"><a class="page-link" href="@Url.Action("Index",new{q=ViewBag.Query,categoryId=ViewBag.CategoryId,sort=ViewBag.Sort,page=i})">@i</a></li>}</ul></nav>

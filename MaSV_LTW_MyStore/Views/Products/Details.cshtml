@model MaSV_LTW_MyStore.Models.Product
<div class="row g-4"><div class="col-md-5"><img class="img-fluid bg-white rounded" src="@(string.IsNullOrEmpty(Model.ProductImage)?"https://placehold.co/600x450?text=Product":Url.Content(Model.ProductImage))"/></div><div class="col-md-7"><span class="badge bg-secondary">@Model.Category.CategoryName</span><h2 class="mt-2">@Model.ProductName</h2><h3 class="price">@Model.ProductPrice.ToString("N0") đ</h3><p>@Model.ProductDecription</p><a class="btn btn-primary" href="@Url.Action("Add","Cart",new{id=Model.ProductID})">Thêm vào giỏ hàng</a><a class="btn btn-outline-secondary ms-2" href="@Url.Action("Index")">Quay lại</a></div></div>

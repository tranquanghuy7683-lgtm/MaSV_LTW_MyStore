@model IEnumerable<MaSV_LTW_MyStore.Models.StoreOrder>
<h2>Lịch sử mua hàng</h2><table class="table table-striped"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th>Địa chỉ</th></tr></thead><tbody>@foreach(var o in Model){<tr><td>#@o.OrderID</td><td>@o.OrderDate.ToString("dd/MM/yyyy")</td><td>@o.TotalAmount.ToString("N0") đ</td><td>@o.PaymentStatus</td><td>@o.AddressDelivery</td></tr>}</tbody></table>

@model List<MaSV_LTW_MyStore.Models.CartItem>
<h2>Giỏ hàng</h2>@if(Model==null||Model.Count==0){<div class="alert alert-info">Giỏ hàng đang trống. <a href="@Url.Action("Index","Products")">Tiếp tục mua sắm</a></div>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead><tbody>@foreach(var i in Model){<tr><td>@i.ProductName</td><td>@i.UnitPrice.ToString("N0") đ</td><td>@using(Html.BeginForm("Update","Cart",FormMethod.Post,new{@class="d-flex gap-2"})){<input type="hidden" name="id" value="@i.ProductID"/><input type="number" name="quantity" min="0" value="@i.Quantity" class="form-control" style="width:85px"/><button class="btn btn-sm btn-outline-primary">Cập nhật</button>}</td><td>@i.Total.ToString("N0") đ</td><td><a class="btn btn-sm btn-outline-danger" href="@Url.Action("Remove",new{id=i.ProductID})">Xóa</a></td></tr>}</tbody></table></div><h4 class="text-end">Tổng: @Model.Sum(x=>x.Total).ToString("N0") đ</h4><div class="card mt-3"><div class="card-body"><h5>Thông tin giao hàng</h5>@using(Html.BeginForm("Checkout","Orders",FormMethod.Post)){@Html.AntiForgeryToken()<label class="form-label">Địa chỉ giao hàng</label><input name="address" class="form-control mb-3" required/><button class="btn btn-success">Đặt hàng</button>}</div></div>}

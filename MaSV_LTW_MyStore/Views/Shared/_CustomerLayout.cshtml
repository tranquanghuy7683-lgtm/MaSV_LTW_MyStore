<!DOCTYPE html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewBag.Title - MyStore</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/><style>body{background:#f6f7fb}.navbar-brand{font-weight:700}.product{height:100%;transition:.2s}.product:hover{transform:translateY(-3px)}.price{color:#dc3545;font-weight:700}.hero{background:linear-gradient(120deg,#172554,#2563eb);color:white;border-radius:16px;padding:36px}</style></head><body><nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand" href="@Url.Action("Index","Home")">MyStore</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div id="nav" class="collapse navbar-collapse"><ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Products")">Sản phẩm</a></li><li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Categories")">Danh mục</a></li><li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Cart")">Giỏ hàng</a></li></ul><ul class="navbar-nav"><li class="nav-item"><a class="nav-link" href="@Url.Action("History","Orders")">Lịch sử mua</a></li>@if(Session["Username"]==null){<li class="nav-item"><a class="nav-link" href="@Url.Action("Login","Account")">Đăng nhập</a></li><li class="nav-item"><a class="nav-link" href="@Url.Action("Register","Account")">Đăng ký</a></li>}else{<li class="nav-item"><span class="navbar-text me-3">@Session["Username"]</span></li><li class="nav-item"><a class="nav-link" href="@Url.Action("Logout","Account")">Đăng xuất</a></li>@if((string)Session["Role"]=="A"){<li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Dashboard",new{area="Admin"})">Quản trị</a></li>}}</ul></div></div></nav><main class="container py-4">@if(TempData["Message"]!=null){<div class="alert alert-success">@TempData["Message"]</div>}@RenderBody()</main><footer class="text-center text-muted py-4">© @DateTime.Now.Year MyStore - Website bán hàng</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>

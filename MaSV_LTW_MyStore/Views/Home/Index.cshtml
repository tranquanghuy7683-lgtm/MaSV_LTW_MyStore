@model IEnumerable<MaSV_LTW_MyStore.Models.Product>
<div class="hero mb-4"><h1>Chào mừng đến MyStore</h1><p class="lead">Khám phá sản phẩm yêu thích với trải nghiệm mua sắm đơn giản.</p><a class="btn btn-light" href="@Url.Action("Index","Products")">Xem tất cả sản phẩm</a></div><div class="d-flex justify-content-between align-items-center mb-3"><h3>Sản phẩm mới</h3><a href="@Url.Action("Index","Products")">Xem thêm</a></div><div class="row g-3">@foreach(var p in Model){<div class="col-6 col-md-3"><div class="card product shadow-sm"><img class="card-img-top" style="height:170px;object-fit:contain;background:white" src="@(string.IsNullOrEmpty(p.ProductImage)?"https://placehold.co/300x200?text=MyStore":Url.Content(p.ProductImage))"/><div class="card-body"><small class="text-muted">@p.Category.CategoryName</small><h6 class="mt-2">@p.ProductName</h6><div class="price">@p.ProductPrice.ToString("N0") đ</div><a class="btn btn-primary btn-sm mt-2" href="@Url.Action("Details","Products",new{id=p.ProductID})">Chi tiết</a></div></div></div>}</div>
